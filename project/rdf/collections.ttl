@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema1: <http://schema.org/> .
<https://w3id.org/lmodel/collections/Bag> a linkml:ClassDefinition ;
	skos:exactMatch "coll:Bag"^^xsd:anyURI , "odpbag:Bag"^^xsd:anyURI , "swan:Bag"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	linkml:class_uri "http://purl.org/co/Bag"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/Bag"^^xsd:anyURI ;
	linkml:description "A collection that may hold one element more than once, in no order." ;
	linkml:disjoint_with <https://w3id.org/lmodel/collections/Set> ;
	linkml:is_a <https://w3id.org/lmodel/collections/Collection> ;
	linkml:slot_usage _:c14n19 ;
	linkml:slots <https://w3id.org/lmodel/collections/co_size> , <https://w3id.org/lmodel/collections/element> , <https://w3id.org/lmodel/collections/item> .
<https://w3id.org/lmodel/collections/CoElement> a linkml:ClassDefinition ;
	skos:editorialNote "Not a term of CO, so its IRI is the schema's own. CO says that what an item wraps is not itself an item, which disjoint_with states." ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:note "CO puts no limit on what a collection holds. A value of element or itemContent is the IRI of a CoElement, so the RDF of a collection links to its elements rather than holding their IRIs as text." ;
	linkml:attributes <https://w3id.org/lmodel/collections/iri> ;
	linkml:class_uri "https://w3id.org/lmodel/collections/CoElement"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/CoElement"^^xsd:anyURI ;
	linkml:description "A thing that a collection holds, named by its IRI." ;
	linkml:disjoint_with <https://w3id.org/lmodel/collections/CoItem> ;
	linkml:slot_usage _:c14n17 ;
	linkml:slots <https://w3id.org/lmodel/collections/coElement__iri> .
<https://w3id.org/lmodel/collections/CoItem> a linkml:ClassDefinition ;
	skos:altLabel "Item" ;
	skos:editorialNote "CO says that every item is an item of some bag. The schema leaves itemOf optional, since a bag holds its items inline." ;
	skos:exactMatch "coll:Item"^^xsd:anyURI , "odpbag:Item"^^xsd:anyURI , "swan:Item"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	linkml:class_uri "http://purl.org/co/Item"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/CoItem"^^xsd:anyURI ;
	linkml:description "An entry of a bag, which wraps one of the bag's elements." ;
	linkml:slot_usage _:c14n8 ;
	linkml:slots <https://w3id.org/lmodel/collections/CoItem_itemContent> .
<https://w3id.org/lmodel/collections/CoItem_itemContent> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/collections-ontology/collections-ontology/blob/58e55d956991878307d430eede7790d5e5da206f/StructureBag.md"^^xsd:anyURI ;
	skos:closeMatch "http://schema.org/item"^^xsd:anyURI ;
	skos:editorialNote "CoItem requires it. CO's OWL file makes itemContent functional, so an item wraps at most one element, and CO's wiki page StructureBag says that an item links exactly one resource." ;
	skos:exactMatch "http://swan.mindinformatics.org/ontologies/1.2/collections/itemContent"^^xsd:anyURI , "http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemContent"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/co/itemContent"^^xsd:anyURI ;
	skos:narrowMatch "http://purl.org/ontology/mo/publication_of"^^xsd:anyURI , "http://www.openarchives.org/ore/terms/proxyFor"^^xsd:anyURI ;
	skos:prefLabel "itemContent" ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/itemContent"^^xsd:anyURI ;
	linkml:description "The element that the item wraps." ;
	linkml:domain <https://w3id.org/lmodel/collections/CoItem> ;
	linkml:domain_of <https://w3id.org/lmodel/collections/CoItem> ;
	linkml:is_a <https://w3id.org/lmodel/collections/itemContent> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/collections/CoItem> ;
	linkml:range <https://w3id.org/lmodel/collections/CoElement> ;
	linkml:required true ;
	linkml:slot_uri "http://purl.org/co/itemContent"^^xsd:anyURI ;
	linkml:usage_slot_name "itemContent" .
<https://w3id.org/lmodel/collections/Collection> a linkml:ClassDefinition ;
	skos:exactMatch "coll:Collection"^^xsd:anyURI , "odpce:Collection"^^xsd:anyURI , "swan:Collection"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:narrowMatch "ore:Aggregation"^^xsd:anyURI ;
	skos:note "Its children are marked mutually disjoint because gen-owl drops disjoint_with (linkml issue 3950), so this is how the generated ontology states that a set is never a bag." ;
	linkml:children_are_mutually_disjoint true ;
	linkml:class_uri "http://purl.org/co/Collection"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/Collection"^^xsd:anyURI ;
	linkml:description "A group of things that is taken as a whole." ;
	linkml:disjoint_with <https://w3id.org/lmodel/collections/CoItem> ;
	linkml:slot_usage _:c14n21 ;
	linkml:slots <https://w3id.org/lmodel/collections/co_size> , <https://w3id.org/lmodel/collections/element> .
<https://w3id.org/lmodel/collections/List> a linkml:ClassDefinition ;
	skos:broadMatch "schema:ItemList"^^xsd:anyURI ;
	skos:exactMatch "coll:List"^^xsd:anyURI , "odplist:List"^^xsd:anyURI , "swan:List"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:narrowMatch "mo:Record"^^xsd:anyURI ;
	skos:note "No validator checks the order: that the indexes count from 1 with no gap or repeat, and that firstItem, lastItem and each item's links agree with them. The tests check it." ;
	linkml:class_uri "http://purl.org/co/List"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/List"^^xsd:anyURI ;
	linkml:description "A collection whose items come in order, one after another." ;
	linkml:is_a <https://w3id.org/lmodel/collections/Bag> ;
	linkml:slot_usage _:c14n23 ;
	linkml:slots <https://w3id.org/lmodel/collections/List_item> , <https://w3id.org/lmodel/collections/co_size> , <https://w3id.org/lmodel/collections/element> , <https://w3id.org/lmodel/collections/firstItem> , <https://w3id.org/lmodel/collections/lastItem> .
<https://w3id.org/lmodel/collections/ListItem> a linkml:ClassDefinition ;
	skos:closeMatch "schema:ListItem"^^xsd:anyURI ;
	skos:exactMatch "coll:ListItem"^^xsd:anyURI , "odplist:ListItem"^^xsd:anyURI , "swan:ListItem"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:narrowMatch "mo:Track"^^xsd:anyURI , "ore:Proxy"^^xsd:anyURI ;
	linkml:class_uri "http://purl.org/co/ListItem"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/ListItem"^^xsd:anyURI ;
	linkml:description "An item of a list, which has a place in the list's order." ;
	linkml:is_a <https://w3id.org/lmodel/collections/CoItem> ;
	linkml:slot_usage _:c14n26 ;
	linkml:slots <https://w3id.org/lmodel/collections/CoItem_itemContent> , <https://w3id.org/lmodel/collections/ListItem_co_index> , <https://w3id.org/lmodel/collections/followedBy> , <https://w3id.org/lmodel/collections/nextItem> , <https://w3id.org/lmodel/collections/precededBy> , <https://w3id.org/lmodel/collections/previousItem> .
<https://w3id.org/lmodel/collections/ListItem_co_index> a linkml:SlotDefinition ;
	skos:altLabel "index" ;
	skos:closeMatch "http://schema.org/position"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/co/index"^^xsd:anyURI ;
	skos:narrowMatch "http://purl.org/ontology/mo/track_number"^^xsd:anyURI ;
	skos:prefLabel "co_index" ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/co_index"^^xsd:anyURI ;
	linkml:description "The place of the item in its list, counting from 1." ;
	linkml:domain <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:domain_of <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:is_a <https://w3id.org/lmodel/collections/co_index> ;
	linkml:is_usage_slot true ;
	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:range <https://w3id.org/lmodel/collections/integer> ;
	linkml:required true ;
	linkml:slot_uri "http://purl.org/co/index"^^xsd:anyURI ;
	linkml:usage_slot_name "co_index" .
<https://w3id.org/lmodel/collections/List_item> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/co/item"^^xsd:anyURI ;
	skos:narrowMatch "http://purl.org/ontology/mo/track"^^xsd:anyURI , "http://swan.mindinformatics.org/ontologies/1.2/collections/item"^^xsd:anyURI ;
	skos:note "In a list, the item after an item of the list is also an item of it, as the path rule states after CO's property chain." ;
	skos:prefLabel "item" ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/item"^^xsd:anyURI ;
	linkml:description "An item of the bag, which holds one of its elements." ;
	linkml:domain <https://w3id.org/lmodel/collections/List> ;
	linkml:domain_of <https://w3id.org/lmodel/collections/List> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/collections/item> ;
	linkml:is_usage_slot true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/collections/List> ;
	linkml:path_rule _:c14n2 ;
	linkml:range <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:slot_uri "http://purl.org/co/item"^^xsd:anyURI ;
	linkml:usage_slot_name "item" .
<https://w3id.org/lmodel/collections/Set> a linkml:ClassDefinition ;
	skos:exactMatch "coll:Set"^^xsd:anyURI , "odpset:Set"^^xsd:anyURI , "swan:Set"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:note "No validator checks that the elements differ: LinkML 1.12.1's generators drop list_elements_unique, so the tests check it." ;
	linkml:class_uri "http://purl.org/co/Set"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/Set"^^xsd:anyURI ;
	linkml:description "A collection that holds each of its elements once." ;
	linkml:is_a <https://w3id.org/lmodel/collections/Collection> ;
	linkml:slot_usage _:c14n10 ;
	linkml:slots <https://w3id.org/lmodel/collections/Set_element> , <https://w3id.org/lmodel/collections/co_size> .
<https://w3id.org/lmodel/collections/Set_element> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/co/element"^^xsd:anyURI ;
	skos:narrowMatch "http://swan.mindinformatics.org/ontologies/1.2/collections/element"^^xsd:anyURI , "http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#hasMember"^^xsd:anyURI , "http://www.openarchives.org/ore/terms/aggregates"^^xsd:anyURI ;
	skos:note "In a bag, each item's itemContent is also an element, as the path rule states after CO's property chain." ;
	skos:prefLabel "element" ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/element"^^xsd:anyURI ;
	linkml:description "A thing the collection holds, named by its IRI." ;
	linkml:domain <https://w3id.org/lmodel/collections/Set> ;
	linkml:domain_of <https://w3id.org/lmodel/collections/Set> ;
	linkml:is_a <https://w3id.org/lmodel/collections/element> ;
	linkml:is_usage_slot true ;
	linkml:list_elements_unique true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/collections/Set> ;
	linkml:path_rule _:c14n16 ;
	linkml:range <https://w3id.org/lmodel/collections/CoElement> ;
	linkml:slot_uri "http://purl.org/co/element"^^xsd:anyURI ;
	linkml:usage_slot_name "element" .
<https://w3id.org/lmodel/collections/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/collections/coElement__iri> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:prefLabel "iri" ;
	linkml:description "The IRI of the thing." ;
	linkml:domain_of <https://w3id.org/lmodel/collections/CoElement> ;
	linkml:identifier true ;
	linkml:owner <https://w3id.org/lmodel/collections/CoElement> ;
	linkml:range <https://w3id.org/lmodel/collections/uriorcurie> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/collections/iri"^^xsd:anyURI .
<https://w3id.org/lmodel/collections/co_index> a linkml:SlotDefinition ;
	skos:altLabel "index" ;
	skos:closeMatch "http://schema.org/position"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/co/index"^^xsd:anyURI ;
	skos:narrowMatch "http://purl.org/ontology/mo/track_number"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/co_index"^^xsd:anyURI ;
	linkml:description "The place of the item in its list, counting from 1." ;
	linkml:domain <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:domain_of <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/collections/ListItem> ;
	linkml:range <https://w3id.org/lmodel/collections/integer> ;
	linkml:slot_uri "http://purl.org/co/index"^^xsd:anyURI .
<https://w3id.org/lmodel/collections/co_size> a linkml:SlotDefinition ;
	skos:altLabel "size" ;
	skos:editorialNote "CO gives every collection exactly one size. The schema leaves it optional, since a reader can count; where it is given, the tests check that it equals the count." ;
	skos:exactMatch "http://swan.mindinformatics.org/ontologies/1.2/collections/size"^^xsd:anyURI , "http://www.ontologydesignpatterns.org/cp/owl/bag.owl#size"^^xsd:anyURI , "http://www.ontologydesignpatterns.org/cp/owl/set.owl#size"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/co/size"^^xsd:anyURI ;
	skos:narrowMatch "http://purl.org/ontology/mo/track_count"^^xsd:anyURI , "http://schema.org/numberOfItems"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/collections/co_size"^^xsd:anyURI ;
	linkml:description "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list." ;
	linkml:domain <https://w3id.org/lmodel/collections/Collection> ;
	linkml:domain_of <https://w3id.org/lmodel/collections/Collection> ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/collections/Collection> ;
	linkml:range <https://w3id.org/lmodel/collections/integer> ;
	linkml:slot_uri "http://purl.org/co/size"^^xsd:anyURI .
<https://w3id.org/lmodel/collections/collections> dcterms:license "Apache-2.0" ;
	dcterms:source "https://github.com/collections-ontology/collections-ontology"^^xsd:anyURI ;
	dcterms:title "Collections Ontology (CO)" ;
	pav:version "2.0" ;
	schema1:inLanguage "en" ;
	schema1:keywords "bag" , "collection" , "list" , "ordered list" , "set" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://doi.org/10.3233/SW-130121"^^xsd:anyURI , "https://lmodel.github.io/collections"^^xsd:anyURI ;
	skos:editorialNote "CO's Item and size are named CoItem and co_size, as in lmodel/uco's uco_co module, because UCO defines an Item and a size of its own. CO's index is named co_index, because gen-doc writes the page of a slot named index over the schema's index page. Their IRIs are CO's." ;
	skos:note "Items have no IRI here, so a slot that links to an item, such as firstItem or nextItem, holds a copy of that item. docs/index.md lists the rules of CO that no validator checks and the tests check instead." , "Renders CO 2.0 by Paolo Ciccarese and Silvio Peroni, whose ontology IRI is http://purl.org/co. The source is collections.owl at the commit the co_commit annotation names, copied unchanged to upstream/collections.owl." , "The exact, narrow and broad mappings to SWAN Collections 1.2, the ontologydesignpatterns.org patterns, the Music Ontology and OAI-ORE are those of CO's own alignment.owl, copied unchanged to upstream/alignment.owl. That file writes ORE's namespace as http://www.openarchives.org/ore/items/, where ORE defines its terms under http://www.openarchives.org/ore/terms/, which the mappings use. The mappings to schema.org are this project's own, after schema.org's ItemList and ListItem, which link list items the same way." , "The repository states no licence. The project's Google Code archive gives the Apache License 2.0 for its code, collections.owl among it, and CC BY 3.0 for its other content, such as its wiki, as the co_licence annotation says. The descriptions here are this project's own words." ;
	sh:declare _:c14n0 , _:c14n1 , _:c14n12 , _:c14n13 , _:c14n14 , _:c14n15 , _:c14n18 , _:c14n20 , _:c14n22 , _:c14n24 , _:c14n5 , _:c14n6 ;
	linkml:annotations _:c14n25 , _:c14n3 , _:c14n4 , _:c14n9 ;
	linkml:classes <https://w3id.org/lmodel/collections/Bag> , <https://w3id.org/lmodel/collections/CoElement> , <https://w3id.org/lmodel/collections/CoItem> , <https://w3id.org/lmodel/collections/Collection> , <https://w3id.org/lmodel/collections/List> , <https://w3id.org/lmodel/collections/ListItem> , <https://w3id.org/lmodel/collections/Set> ;
	linkml:default_prefix "collections" ;
	linkml:default_range <https://w3id.org/lmodel/collections/string> ;
	linkml:description "The Collections Ontology (CO) 2.0 in LinkML, with CO's own names and IRIs: collections that are sets, bags or lists, and the items through which a bag or a list holds its elements." ;
	linkml:id "https://w3id.org/lmodel/collections"^^xsd:anyURI ;
	linkml:imports "linkml:types"^^xsd:anyURI ;
	linkml:metamodel_version "1.12.0" ;
	linkml:slots <https://w3id.org/lmodel/collections/CoItem_itemContent> , <https://w3id.org/lmodel/collections/ListItem_co_index> , <https://w3id.org/lmodel/collections/List_item> , <https://w3id.org/lmodel/collections/Set_element> , <https://w3id.org/lmodel/collections/coElement__iri> , <https://w3id.org/lmodel/collections/co_index> , <https://w3id.org/lmodel/collections/co_size> , <https://w3id.org/lmodel/collections/element> , <https://w3id.org/lmodel/collections/elementOf> , <https://w3id.org/lmodel/collections/firstItem> , <https://w3id.org/lmodel/collections/firstItemOf> , <https://w3id.org/lmodel/collections/followedBy> , <https://w3id.org/lmodel/collections/item> , <https://w3id.org/lmodel/collections/itemContent> , <https://w3id.org/lmodel/collections/itemContentOf> , <https://w3id.org/lmodel/collections/itemOf> , <https://w3id.org/lmodel/collections/lastItem> , <https://w3id.org/lmodel/collections/lastItemOf> , <https://w3id.org/lmodel/collections/nextItem> , <https://w3id.org/lmodel/collections/precededBy> , <https://w3id.org/lmodel/collections/previousItem> ;
	linkml:source_file "collections.yaml" ;
	linkml:source_file_date "2026-11-07T02:03:56"^^xsd:dateTime ;
	linkml:source_file_size 13573 ;
	linkml:types <https://w3id.org/lmodel/collections/boolean> , <https://w3id.org/lmodel/collections/curie> , <https://w3id.org/lmodel/collections/date> , <https://w3id.org/lmodel/collections/date_or_datetime> , <https://w3id.org/lmodel/collections/datetime> , <https://w3id.org/lmodel/collections/decimal> , <https://w3id.org/lmodel/collections/double> , <https://w3id.org/lmodel/collections/float> , <https://w3id.org/lmodel/collections/integer> , <https://w3id.org/lmodel/collections/jsonpath> , <https://w3id.org/lmodel/collections/jsonpointer> , <https://w3id.org/lmodel/collections/ncname> , <https://w3id.org/lmodel/collections/nodeidentifier> , <https://w3id.org/lmodel/collections/objectidentifier> , <https://w3id.org/lmodel/collections/sparqlpath> , <https://w3id.org/lmodel/collections/string> , <https://w3id.org/lmodel/collections/time> , <https://w3id.org/lmodel/collections/uri> , <https://w3id.org/lmodel/collections/uriorcurie> .
<https://w3id.org/lmodel/collections/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
