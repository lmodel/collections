<https://w3id.org/lmodel/collections/previousItem> a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/collections/nextItem> ;
	skos:broadMatch "http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#directlyFollows"^^xsd:anyURI ;
	skos:closeMatch "http://schema.org/previousItem"^^xsd:anyURI ;
	skos:editorialNote "CO makes it a narrower form of precededBy. It is stated on precededBy, as transitive_form_of, not here as is_a, for the reason given on nextItem." ;
	skos:exactMatch "http://swan.mindinformatics.org/ontologies/1.2/collections/previousItem"^^xsd:anyURI ;
