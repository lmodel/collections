  "slots": [
    {
      "name": "element",
      "definition_uri": "https://w3id.org/lmodel/collections/element",
      "description": "A thing the collection holds, named by its IRI.",
      "comments": [
        "In a bag, each item's itemContent is also an element, as the path rule states after CO's property chain."
      ],
      "from_schema": "https://w3id.org/lmodel/collections",
      "mappings": [
        "http://purl.org/co/element"
      ],
      "narrow_mappings": [
        "http://swan.mindinformatics.org/ontologies/1.2/collections/element",
        "http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#hasMember",
        "http://www.openarchives.org/ore/terms/aggregates"
      ],
      "domain": "Collection",
      "slot_uri": "http://purl.org/co/element",
      "owner": "Collection",
      "domain_of": [
        "Collection"
      ],
      "inverse": "elementOf",
      "path_rule": {
        "followed_by": {
          "traverse": "itemContent",
          "@type": "PathExpression"
        },
        "traverse": "item",
        "@type": "PathExpression"
      },
      "range": "CoElement",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "elementOf",
      "definition_uri": "https://w3id.org/lmodel/collections/elementOf",
      "description": "A collection that holds the thing as an element.",
      "from_schema": "https://w3id.org/lmodel/collections",
      "mappings": [
        "http://purl.org/co/elementOf"
      ],
      "narrow_mappings": [
        "http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf"
      ],
      "domain": "CoElement",
      "slot_uri": "http://purl.org/co/elementOf",
      "owner": "elementOf",
      "inverse": "element",
      "range": "Collection",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "co_size",
      "definition_uri": "https://w3id.org/lmodel/collections/co_size",
      "description": "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list.",
      "notes": [
        "CO gives every collection exactly one size. The schema leaves it optional, since a reader can count; where it is given, the tests check that it equals the count."
      ],
      "from_schema": "https://w3id.org/lmodel/collections",
      "aliases": [
        "size"
      ],
      "mappings": [
        "http://purl.org/co/size"
      ],
      "exact_mappings": [
        "http://swan.mindinformatics.org/ontologies/1.2/collections/size",
        "http://www.ontologydesignpatterns.org/cp/owl/bag.owl#size",
        "http://www.ontologydesignpatterns.org/cp/owl/set.owl#size"
      ],
      "narrow_mappings": [
        "http://purl.org/ontology/mo/track_count",
        "http://schema.org/numberOfItems"
      ],
      "domain": "Collection",
      "slot_uri": "http://purl.org/co/size",
      "owner": "Collection",
      "domain_of": [
        "Collection"
      ],
      "range": "integer",
      "minimum_value": 0,
      "@type": "SlotDefinition"
    },
    {
      "name": "item",
      "definition_uri": "https://w3id.org/lmodel/collections/item",
      "description": "An item of the bag, which holds one of its elements.",
      "comments": [
        "In a list, the item after an item of the list is also an item of it, as the path rule states after CO's property chain."
      ],
      "from_schema": "https://w3id.org/lmodel/collections",
      "mappings": [
        "http://purl.org/co/item"
      ],
      "narrow_mappings": [
        "http://swan.mindinformatics.org/ontologies/1.2/collections/item",
        "http://purl.org/ontology/mo/track"
      ],
      "domain": "Bag",
      "slot_uri": "http://purl.org/co/item",
      "owner": "Bag",
      "domain_of": [
        "Bag"
      ],
      "inverse": "itemOf",
      "path_rule": {
        "followed_by": {
          "traverse": "nextItem",
          "@type": "PathExpression"
        },
        "traverse": "item",
        "@type": "PathExpression"
      },
      "range": "CoItem",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "itemOf",
      "definition_uri": "https://w3id.org/lmodel/collections/itemOf",
      "description": "A bag that holds the item.",
      "from_schema": "https://w3id.org/lmodel/collections",
      "mappings": [
        "http://purl.org/co/itemOf"
      ],
      "narrow_mappings": [
        "http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemOf",
        "http://www.openarchives.org/ore/terms/proxyIn"
      ],
      "domain": "CoItem",
      "slot_uri": "http://purl.org/co/itemOf",
      "owner": "itemOf",
      "inverse": "item",
      "range": "Bag",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "itemContent",
      "definition_uri": "https://w3id.org/lmodel/collections/itemContent",
      "description": "The element that the item wraps.",
      "notes": [
        "CoItem requires it. CO's OWL file makes itemContent functional, so an item wraps at most one element, and CO's wiki page StructureBag says that an item links exactly one resource."
      ],
      "from_schema": "https://w3id.org/lmodel/collections",
      "see_also": [
        "https://github.com/collections-ontology/collections-ontology/blob/58e55d956991878307d430eede7790d5e5da206f/StructureBag.md"
      ],
      "mappings": [
        "http://purl.org/co/itemContent"
      ],
      "exact_mappings": [
        "http://swan.mindinformatics.org/ontologies/1.2/collections/itemContent",
        "http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemContent"
      ],
      "close_mappings": [
        "http://schema.org/item"
      ],
      "narrow_mappings": [
        "http://purl.org/ontology/mo/publication_of",
        "http://www.openarchives.org/ore/terms/proxyFor"
      ],
      "domain": "CoItem",
      "slot_uri": "http://purl.org/co/itemContent",
      "owner": "CoItem",
      "domain_of": [
        "CoItem"
      ],
      "inverse": "itemContentOf",
      "range": "CoElement",
      "@type": "SlotDefinition"
    },
    {
      "name": "itemContentOf",
      "definition_uri": "https://w3id.org/lmodel/collections/itemContentOf",
      "description": "An item that wraps the thing.",
      "from_schema": "https://w3id.org/lmodel/collections",
      "mappings": [
        "http://purl.org/co/itemContentOf"
      ],
      "narrow_mappings": [
        "http://purl.org/ontology/mo/published_as"
      ],
      "domain": "CoElement",
      "slot_uri": "http://purl.org/co/itemContentOf",
      "owner": "itemContentOf",
      "inverse": "itemContent",
