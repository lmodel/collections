    {
      "name": "CoElement",
      "definition_uri": "https://w3id.org/lmodel/collections/CoElement",
      "description": "A thing that a collection holds, named by its IRI.",
      "notes": [
        "Not a term of CO, so its IRI is the schema's own. CO says that what an item wraps is not itself an item, which disjoint_with states."
      ],
      "comments": [
        "CO puts no limit on what a collection holds. A value of element or itemContent is the IRI of a CoElement, so the RDF of a collection links to its elements rather than holding their IRIs as text."
      ],
      "from_schema": "https://w3id.org/lmodel/collections",
      "slots": [
        "coElement__iri"
      ],
