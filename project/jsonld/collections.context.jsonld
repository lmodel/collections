{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "coll": "http://purl.org/co/",
      "collections": "https://w3id.org/lmodel/collections/",
      "linkml": "https://w3id.org/linkml/",
      "@vocab": "https://w3id.org/lmodel/collections/",
      "co_index": {
         "@type": "xsd:integer",
         "@id": "coll:index"
      },
      "co_size": {
         "@type": "xsd:integer",
         "@id": "coll:size"
      },
      "element": {
         "@type": "xsd:anyURI",
         "@id": "coll:element"
      },
      "elementOf": {
         "@type": "@id",
         "@id": "coll:elementOf"
      },
      "firstItem": {
         "@type": "@id",
         "@id": "coll:firstItem"
      },
      "firstItemOf": {
         "@type": "@id",
         "@id": "coll:firstItemOf"
      },
      "followedBy": {
         "@type": "@id",
         "@id": "coll:followedBy"
      },
      "item": {
         "@type": "@id",
         "@id": "coll:item"
      },
      "itemContent": {
         "@type": "xsd:anyURI",
         "@id": "coll:itemContent"
      },
      "itemContentOf": {
         "@type": "@id",
         "@id": "coll:itemContentOf"
      },
      "itemOf": {
         "@type": "@id",
         "@id": "coll:itemOf"
      },
      "lastItem": {
         "@type": "@id",
         "@id": "coll:lastItem"
      },
      "lastItemOf": {
         "@type": "@id",
         "@id": "coll:lastItemOf"
      },
      "nextItem": {
         "@type": "@id",
         "@id": "coll:nextItem"
      },
      "precededBy": {
         "@type": "@id",
         "@id": "coll:precededBy"
      },
      "previousItem": {
         "@type": "@id",
         "@id": "coll:previousItem"
      },
      "Bag": {
         "@id": "coll:Bag"
      },
      "CoItem": {
         "@id": "coll:Item"
      },
      "Collection": {
         "@id": "coll:Collection"
      },
      "List": {
         "@id": "coll:List"
      },
      "ListItem": {
         "@id": "coll:ListItem"
      },
      "Set": {
         "@id": "coll:Set"
      }
   }
}
