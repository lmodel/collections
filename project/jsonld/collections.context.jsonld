{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "coll": "http://purl.org/co/",
      "collections": "https://w3id.org/lmodel/collections/",
      "linkml": "https://w3id.org/linkml/",
      "mo": "http://purl.org/ontology/mo/",
      "odpbag": "http://www.ontologydesignpatterns.org/cp/owl/bag.owl#",
      "odpce": "http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#",
      "odplist": "http://www.ontologydesignpatterns.org/cp/owl/list.owl#",
      "odpset": "http://www.ontologydesignpatterns.org/cp/owl/set.owl#",
      "ore": "http://www.openarchives.org/ore/terms/",
      "schema": "http://schema.org/",
      "seq": "http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#",
      "swan": "http://swan.mindinformatics.org/ontologies/1.2/collections/",
      "@vocab": "https://w3id.org/lmodel/collections/",
      "co_index": {
         "@type": "xsd:integer",
         "@id": "coll:index"
      },
      "co_size": {
         "@type": "xsd:integer",
         "@id": "coll:size"
      },
      "iri": "@id",
      "element": {
         "@type": "@id",
         "@id": "coll:element"
      },
      "elementOf": {
         "@type": "@id",
         "@id": "coll:elementOf"
      },
      "firstItem": {
         "@type": "@id",
         "@id": "coll:firstItem"
      },
      "firstItemOf": {
         "@type": "@id",
         "@id": "coll:firstItemOf"
      },
      "followedBy": {
         "@type": "@id",
         "@id": "coll:followedBy"
      },
      "item": {
         "@type": "@id",
         "@id": "coll:item"
      },
      "itemContent": {
         "@type": "@id",
         "@id": "coll:itemContent"
      },
      "itemContentOf": {
         "@type": "@id",
         "@id": "coll:itemContentOf"
      },
      "itemOf": {
         "@type": "@id",
         "@id": "coll:itemOf"
      },
      "lastItem": {
         "@type": "@id",
         "@id": "coll:lastItem"
      },
      "lastItemOf": {
         "@type": "@id",
         "@id": "coll:lastItemOf"
      },
      "nextItem": {
         "@type": "@id",
         "@id": "coll:nextItem"
      },
      "precededBy": {
         "@type": "@id",
         "@id": "coll:precededBy"
      },
      "previousItem": {
         "@type": "@id",
         "@id": "coll:previousItem"
      },
      "Bag": {
         "@id": "coll:Bag"
      },
      "CoElement": {
         "@id": "CoElement"
      },
      "CoItem": {
         "@id": "coll:Item"
      },
      "Collection": {
         "@id": "coll:Collection"
      },
      "List": {
         "@id": "coll:List"
      },
      "ListItem": {
         "@id": "coll:ListItem"
      },
      "Set": {
         "@id": "coll:Set"
      }
   }
}
