{
    "$defs": {
        "Bag": {
            "additionalProperties": false,
            "description": "A collection that may hold one element more than once, in no order.",
            "properties": {
                "co_size": {
                    "description": "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "element": {
                    "description": "A thing the collection holds, named by its IRI.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "item": {
                    "description": "An item of the bag, which holds one of its elements.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/CoItem"
                            },
                            {
                                "$ref": "#/$defs/ListItem"
                            }
                        ]
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "Bag",
            "type": "object"
        },
        "CoItem": {
            "additionalProperties": false,
            "description": "An entry of a bag, which wraps one of the bag's elements.",
            "properties": {
                "itemContent": {
                    "description": "The element that the item wraps.",
                    "type": "string"
                }
            },
            "required": [
                "itemContent"
            ],
            "title": "CoItem",
            "type": "object"
        },
        "Collection": {
            "additionalProperties": false,
            "description": "A group of things that is taken as a whole.",
            "properties": {
                "co_size": {
                    "description": "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "element": {
                    "description": "A thing the collection holds, named by its IRI.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "Collection",
            "type": "object"
        },
        "List": {
            "additionalProperties": false,
            "description": "A collection whose items come in order, one after another.",
            "properties": {
                "co_size": {
                    "description": "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "element": {
                    "description": "A thing the collection holds, named by its IRI.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "firstItem": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ListItem"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The first item of the list."
                },
                "item": {
                    "description": "An item of the bag, which holds one of its elements.",
                    "items": {
                        "$ref": "#/$defs/ListItem"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "lastItem": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ListItem"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The last item of the list."
                }
            },
            "title": "List",
            "type": "object"
        },
        "ListItem": {
            "additionalProperties": false,
            "description": "An item of a list, which has a place in the list's order.",
            "properties": {
                "followedBy": {
                    "description": "An item that comes somewhere after this one.",
                    "items": {
                        "$ref": "#/$defs/ListItem"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "index": {
                    "description": "The place of the item in its list, counting from 1.",
                    "minimum": 1,
                    "type": "integer"
                },
                "itemContent": {
                    "description": "The element that the item wraps.",
                    "type": "string"
                },
                "nextItem": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ListItem"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The item that comes straight after this one."
                },
                "precededBy": {
                    "description": "An item that comes somewhere before this one.",
                    "items": {
                        "$ref": "#/$defs/ListItem"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "previousItem": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ListItem"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The item that comes straight before this one."
                }
            },
            "required": [
                "index",
                "itemContent"
            ],
            "title": "ListItem",
            "type": "object"
        },
        "Set": {
            "additionalProperties": false,
            "description": "A collection that holds each of its elements once.",
            "properties": {
                "co_size": {
                    "description": "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "element": {
                    "description": "A thing the collection holds, named by its IRI.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "Set",
            "type": "object"
        }
    },
    "$id": "https://w3id.org/lmodel/collections",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": true,
    "metamodel_version": "1.12.0",
    "title": "collections",
    "type": "object",
    "version": "2.0"
}
