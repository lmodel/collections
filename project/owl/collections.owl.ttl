@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix collections: <https://w3id.org/lmodel/collections/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pav: <http://purl.org/pav/> .
@prefix coll: <http://purl.org/co/> .
<https://w3id.org/lmodel/collections.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/collections-ontology/collections-ontology> ;
	dcterms:title "Collections Ontology (CO)" ;
	pav:version "2.0" ;
	a owl:Ontology ;
	rdfs:label "collections" ;
	rdfs:seeAlso <https://doi.org/10.3233/SW-130121> , <https://lmodel.github.io/collections> ;
	skos:definition "The Collections Ontology (CO) 2.0 in LinkML, with CO's own names and IRIs: collections that are sets, bags or lists, and the items through which a bag or a list holds its elements." ;
	skos:editorialNote "CO's Item and size are named CoItem and co_size, as in lmodel/uco's uco_co module, because UCO defines an Item and a size of its own. CO's index is named co_index, because gen-doc writes the page of a slot named index over the schema's index page. Their IRIs are CO's." ;
	skos:note "Items have no IRI here, so a slot that links to an item, such as firstItem or nextItem, holds a copy of that item. docs/index.md lists the rules of CO that no validator checks and the tests check instead." , "Renders CO 2.0 by Paolo Ciccarese and Silvio Peroni, whose ontology IRI is http://purl.org/co. The source is collections.owl at the commit the co_commit annotation names, copied unchanged to upstream/collections.owl." , "The repository states no licence. The project's Google Code archive gives the Apache License 2.0 for its code and CC BY 3.0 for its content, as the co_licence annotation says. The descriptions here are this project's own words." ;
	collections:co_commit "619e7b02646321174635fd04be658e338bf7d1d7" ;
	collections:co_git_object "4e19e4892212de2b1805923a7a69fa4ba8c1b424" ;
	collections:co_licence "Apache-2.0 for code and CC-BY-3.0 for content, per the Google Code archive" ;
	collections:co_ontology_iri "http://purl.org/co" .
collections:Bag a owl:Class ;
	rdfs:label "Bag" ;
	rdfs:subClassOf collections:Collection , _:c14n26 , _:c14n34 ;
	skos:definition "A collection that may hold one element more than once, in no order." ;
	skos:exactMatch coll:Bag ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:CoItem a owl:Class ;
	rdfs:label "CoItem" ;
	rdfs:subClassOf _:c14n0 , _:c14n10 , _:c14n15 ;
	skos:definition "An entry of a bag, which wraps one of the bag's elements." ;
	skos:exactMatch coll:Item ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:Collection a owl:Class ;
	rdfs:label "Collection" ;
	rdfs:subClassOf _:c14n25 , _:c14n29 , _:c14n31 , _:c14n32 , _:c14n7 ;
	skos:definition "A group of things that is taken as a whole." ;
	skos:exactMatch coll:Collection ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:List a owl:Class ;
	rdfs:label "List" ;
	rdfs:subClassOf collections:Bag , _:c14n11 , _:c14n12 , _:c14n16 , _:c14n2 , _:c14n21 , _:c14n22 , _:c14n28 , _:c14n30 ;
	skos:definition "A collection whose items come in order, one after another." ;
	skos:exactMatch coll:List ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "No validator checks the order: that the indexes count from 1 with no gap or repeat, and that firstItem, lastItem and each item's links agree with them. The tests check it." .
collections:ListItem a owl:Class ;
	rdfs:label "ListItem" ;
	rdfs:subClassOf collections:CoItem , _:c14n1 , _:c14n13 , _:c14n14 , _:c14n17 , _:c14n19 , _:c14n20 , _:c14n24 , _:c14n33 , _:c14n4 , _:c14n5 , _:c14n6 , _:c14n8 , _:c14n9 ;
	skos:definition "An item of a list, which has a place in the list's order." ;
	skos:exactMatch coll:ListItem ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:Set a owl:Class ;
	rdfs:label "Set" ;
	rdfs:subClassOf collections:Collection , _:c14n18 , _:c14n3 ;
	skos:definition "A collection that holds each of its elements once." ;
	skos:exactMatch coll:Set ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "No validator checks that the elements differ: LinkML 1.12.1's generators drop list_elements_unique, so the tests check it." .
collections:co_index a owl:DatatypeProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "co_index" ;
	rdfs:range _:c14n23 ;
	skos:definition "The place of the item in its list, counting from 1." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:co_size a owl:DatatypeProperty ;
	rdfs:domain collections:Collection ;
	rdfs:label "co_size" ;
	rdfs:range _:c14n27 ;
	skos:definition "How many times the collection holds a thing, counting each repeat: the number of elements of a set, or of items of a bag or a list." ;
	skos:editorialNote "CO gives every collection exactly one size. The schema leaves it optional, since a reader can count; where it is given, the tests check that it equals the count." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:element a owl:DatatypeProperty ;
	rdfs:domain collections:Collection ;
	rdfs:label "element" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A thing the collection holds, named by its IRI." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:elementOf a owl:ObjectProperty ;
	rdfs:label "elementOf" ;
	rdfs:range collections:Collection ;
	skos:definition "A collection that holds the thing as an element." ;
	skos:editorialNote "CO declares it the inverse of element. LinkML's Python generator states an inverse only between slots that range over classes, and element ranges over any thing named by its IRI, so the inverse is not stated here." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:firstItem a owl:ObjectProperty ;
	rdfs:domain collections:List ;
	rdfs:label "firstItem" ;
	rdfs:range collections:ListItem ;
	skos:definition "The first item of the list." ;
	skos:editorialNote "CO makes it a narrower form of item, which is not stated here: a LinkML slot inherits its parent's multivalued, and this one is single." ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "It holds a copy of the item with index 1, which has no previous item." .
collections:firstItemOf a owl:ObjectProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "firstItemOf" ;
	rdfs:range collections:List ;
	owl:inverseOf collections:firstItem ;
	skos:definition "A list whose first item this is." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:followedBy a owl:ObjectProperty , owl:TransitiveProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "followedBy" ;
	rdfs:range collections:ListItem ;
	skos:definition "An item that comes somewhere after this one." ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "It holds copies of items whose index is higher." .
collections:item a owl:ObjectProperty ;
	rdfs:domain collections:Bag ;
	rdfs:label "item" ;
	rdfs:range collections:CoItem ;
	skos:definition "An item of the bag, which holds one of its elements." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:itemContent a owl:DatatypeProperty ;
	rdfs:domain collections:CoItem ;
	rdfs:label "itemContent" ;
	rdfs:range xsd:anyURI ;
	skos:definition "The element that the item wraps." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:itemContentOf a owl:ObjectProperty ;
	rdfs:label "itemContentOf" ;
	rdfs:range collections:CoItem ;
	skos:definition "An item that wraps the thing." ;
	skos:editorialNote "CO declares it the inverse of itemContent, which is not stated here for the reason given on elementOf." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:itemOf a owl:ObjectProperty ;
	rdfs:domain collections:CoItem ;
	rdfs:label "itemOf" ;
	rdfs:range collections:Bag ;
	owl:inverseOf collections:item ;
	skos:definition "A bag that holds the item." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:lastItem a owl:ObjectProperty ;
	rdfs:domain collections:List ;
	rdfs:label "lastItem" ;
	rdfs:range collections:ListItem ;
	skos:definition "The last item of the list." ;
	skos:editorialNote "CO makes it a narrower form of item, which is not stated here for the reason given on firstItem." ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "It holds a copy of the item with the highest index, which has no next item." .
collections:lastItemOf a owl:ObjectProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "lastItemOf" ;
	rdfs:range collections:List ;
	owl:inverseOf collections:lastItem ;
	skos:definition "A list whose last item this is." ;
	skos:inScheme <https://w3id.org/lmodel/collections> .
collections:nextItem a owl:ObjectProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "nextItem" ;
	rdfs:range collections:ListItem ;
	skos:definition "The item that comes straight after this one." ;
	skos:editorialNote "CO makes it a narrower form of followedBy, which is not stated here for the reason given on firstItem." ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "It holds a copy of the item whose index is one higher." .
collections:precededBy a owl:ObjectProperty , owl:TransitiveProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "precededBy" ;
	rdfs:range collections:ListItem ;
	owl:inverseOf collections:followedBy ;
	skos:definition "An item that comes somewhere before this one." ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "It holds copies of items whose index is lower." .
collections:previousItem a owl:ObjectProperty ;
	rdfs:domain collections:ListItem ;
	rdfs:label "previousItem" ;
	rdfs:range collections:ListItem ;
	owl:inverseOf collections:nextItem ;
	skos:definition "The item that comes straight before this one." ;
	skos:editorialNote "CO makes it a narrower form of precededBy, which is not stated here for the reason given on firstItem." ;
	skos:inScheme <https://w3id.org/lmodel/collections> ;
	skos:note "It holds a copy of the item whose index is one lower." .
_:c14n0 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty collections:itemContent .
_:c14n1 a owl:Restriction ;
	owl:minCardinality 0 ;
	owl:onProperty collections:precededBy .
_:c14n10 a owl:Restriction ;
	owl:allValuesFrom xsd:anyURI ;
	owl:onProperty collections:itemContent .
_:c14n11 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty collections:lastItem .
